#!/bin/sh
# Reject commit messages carrying a Claude/Anthropic co-author trailer or "Generated with Claude Code" footer.
if grep -Eiq '^co-authored-by:.*(claude|anthropic)|noreply@anthropic\.com|generated with \[?claude code' "$1"; then
  echo "Commit blocked: remove the Claude/Anthropic Co-Authored-By trailer and any 'Generated with Claude Code' line." >&2
  exit 1
fi
